# Browser-safe Supabase settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Server-only settings
ADMIN_LOGIN_EMAIL=admin@example.com
ADMIN_LOGIN_PASSWORD=replace-with-password
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SEC_USER_AGENT=MyPortfolioBuddy your-email@example.com
HEDGE_FUND_LLM_MODEL=gpt-6-sol
OPENAI_API_KEY=replace-with-api-key
OPENAI_VISION_MODEL=gpt-6-sol

# Optional: email delivery for report reminders (any SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MyPortfolioBuddy <reminders@example.com>

# Shown on the Terms and Privacy Policy pages as the contact address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Public address for links, previews and the sitemap (set on Vercel once the domain is connected)
NEXT_PUBLIC_SITE_URL=https://myportfoliobuddy.com
