{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs"
    },
    "api": {
      "root": "apps/api/",
      "framework": "fastapi",
      "entrypoint": "index:app",
      "functions": {
        "index.py": {
          "maxDuration": 300,
          "excludeFiles": "{tests/**,.venv/**,.cache/**,.pytest_cache/**,.ruff_cache/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/api/cron/reminders", "schedule": "0 14 * * *" }]
}
